# Claude Code local settings
.claude/*.local.json

# Master-branch build artifacts that persist in the worktree across
# branch switches. None of these are standalone content: dist/ and
# node_modules/ are master's build output and dependencies, packaging/
# and src-tauri/ hold leftover makepkg and Rust build output once the
# checkout removes master's tracked files, and test-data/ is generated
# by master's gen-test-docs.sh.
dist/
node_modules/
packaging/
src-tauri/
test-data/
