# Claude Code local settings
.claude/*.local.json

# Master-branch build artifacts that persist in the worktree across
# branch switches. None of these are standalone content: dist/ and
# node_modules/ are master's build output and dependencies, src-tauri/
# holds leftover Rust build output once the checkout removes master's
# tracked sources, and test-data/ is generated by master's
# gen-test-docs.sh.
dist/
node_modules/
src-tauri/
test-data/
