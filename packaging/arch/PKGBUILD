# Maintainer: Joseph R. Prostko <joe dot prostko at gmail dot com>

# INTERIM source, pre-remote: clones this repository's committed HEAD
# from its local path (uncommitted changes are invisible to the build).
# Once the first public release exists, swap _srcurl for the public URL
# (#tag=v$pkgver, or the release tarball with real sha256sums instead
# of 'SKIP') and drop this note.

pkgname=skrivro
pkgver=1.0.0
pkgrel=1
pkgdesc="Keyboard-first AsciiDoc and Markdown editor with live preview"
arch=('x86_64')
url="https://github.com/jprostko/skrivro"
license=('0BSD')
# Runtime: direct DT_NEEDED of the binary mapped to owning packages, plus
# hicolor-icon-theme for the icon tree we install into. shared-mime-info
# arrives transitively (gtk3) and its database rebuild runs via pacman
# hooks, so it is deliberately not listed (namcap agrees).
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
)
# Build/stage tooling only. JS deps (Vite Plus, CodeMirror, ...) and Rust
# crates are NOT listed here: pnpm and cargo install them per-lockfile in
# prepare(). librsvg renders the 48x48 icon in stage.sh, and
# desktop-file-utils + appstream are stage.sh's validators.
makedepends=(
  'git'
  'rust'
  'nodejs'
  'pnpm'
  'librsvg'
  'desktop-file-utils'
  'appstream'
)
_srcurl="git+file:///home/jprostko/claude/code/asciidoc-editor"
source=("$pkgname::$_srcurl")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  # Fetch all locked dependencies up front. build() then works offline.
  # pnpm honors the packageManager pin in package.json (may fetch that
  # exact pnpm version on first run).
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  # Frontend first: tauri-build embeds the built dist/ into the binary.
  pnpm run build
  # tauri/custom-protocol is REQUIRED: it is the compile-time switch
  # between a dev binary (connects to devUrl, localhost:1420) and a
  # production binary serving the embedded frontendDist. `tauri build`
  # passes it implicitly. Plain cargo must pass it explicitly. The app's
  # Cargo.toml defines no local feature alias, so target the tauri
  # crate's feature directly.
  cargo build --release --locked --features tauri/custom-protocol \
    --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "$pkgname"
  pnpm run test
}

package() {
  cd "$pkgname"
  # stage.sh derives REPO_ROOT (the clone) and BIN from its own location.
  # Pointing STAGE at pkgdir assembles the install tree directly.
  STAGE="$pkgdir" ./packaging/stage.sh
}
