# Maintainer: Joseph R. Prostko <joe dot prostko at gmail dot com>

pkgname=skrivro
pkgver=1.0.0
pkgrel=1
pkgdesc="Keyboard-first AsciiDoc and Markdown editor with live preview"
arch=('x86_64')
url="https://github.com/jprostko/skrivro"
license=('0BSD')
# Runtime: direct DT_NEEDED of the binary mapped to owning packages, plus
# hicolor-icon-theme for the icon tree we install into. shared-mime-info
# arrives transitively (gtk3) and its database rebuild runs via pacman
# hooks, so it is deliberately not listed (namcap agrees).
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
)
# Build/stage tooling only. JS deps (Vite Plus, CodeMirror, ...) and Rust
# crates are NOT listed here: pnpm and cargo install them per-lockfile in
# prepare(). Vite+ itself comes from the lockfile too and runs through
# pnpm exec, since no pacman package provides vp. librsvg renders the
# 48x48 icon in stage.sh, and desktop-file-utils + appstream are
# stage.sh's validators.
makedepends=(
  'rust'
  'nodejs'
  'pnpm'
  'librsvg'
  'desktop-file-utils'
  'appstream'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/jprostko/skrivro/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2b2fe4c03a3ccebfd62b131499dd93c630067e7644b48f1459d380efc6e379d2')

prepare() {
  cd "$pkgname-$pkgver"
  # Fetch all locked dependencies up front. build() then works offline.
  # pnpm honors the packageManager pin in package.json (may fetch that
  # exact pnpm version on first run).
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The canonical build documented in BUILDING.adoc. Vite+ builds the
  # frontend, then drives cargo with the tauri/custom-protocol feature,
  # the compile-time switch away from dev-server mode. Linux bundling
  # is disabled in tauri.conf.json, so this produces only the binary.
  pnpm exec vp run tauri build
}

check() {
  cd "$pkgname-$pkgver"
  pnpm run test
}

package() {
  cd "$pkgname-$pkgver"
  # stage.sh derives REPO_ROOT (the extracted source) and BIN from its
  # own location. Pointing STAGE at pkgdir assembles the install tree.
  STAGE="$pkgdir" ./packaging/stage.sh
}
