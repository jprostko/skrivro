# Catppuccin Mocha: Skrivro theme (REFERENCE FILE)
#
# This file is NOT loaded at runtime: Catppuccin Mocha is the CSS
# default, so its values are compiled into styles.css as the :root
# fallback. This file exists purely as a reference for theme authors:
# copy it, rename to your-theme.theme, replace each value with your
# palette's best match for the PURPOSE described in the comment.
#
# Place your theme at:
#   Linux:   $XDG_CONFIG_HOME/com.skrivro.editor/themes/your-theme.theme
#            (or ~/.config/com.skrivro.editor/themes/your-theme.theme
#            if XDG_CONFIG_HOME is unset)
#   macOS:   ~/Library/Application Support/com.skrivro.editor/themes/your-theme.theme
#   Windows: %APPDATA%\com.skrivro.editor\themes\your-theme.theme
#
# Then set `theme = your-theme` in skrivro.conf.
#
# Source: Catppuccin Mocha (https://github.com/catppuccin/catppuccin)
# All values below are the official Catppuccin Mocha palette.

# ================= Backgrounds =================
# Hierarchical layers from brightest to deepest.

bg = #1e1e2e
# Primary background: body, editor pane, scrollbar tracks, preview
# block inner bg (exampleblock, sidebarblock, admonition).

bg-panel = #181825
# Chrome / elevated surfaces: titlebar, preview pane, confirm dialog,
# help dialog, CM6 Ex command panel.

bg-inset = #11111b
# Deepest layer: preview code/pre blocks, literalblock, render-error.

bg-backdrop = rgba(17, 17, 27, 0.6)
# Dialog backdrop overlay (semi-transparent). The rgb channels match
# bg-inset, and the alpha controls how much the underlying content
# shows through the modal overlay.

bg-stripe = rgba(49, 50, 68, 0.3)
# Preview table even-row zebra stripe. The rgb channels match the
# surface color, and the alpha keeps the stripe subtle.

bg-active-line = rgba(49, 50, 68, 0.25)
# CM6 active line highlight. Same base as bg-stripe, slightly lower
# alpha so it's visible but not competing with the cursor.

shadow = rgba(0, 0, 0, 0.5)
# Dialog box-shadow. For dark themes, black at 50% is standard. Light
# themes may want a lower alpha (e.g., rgba(0,0,0,0.15)) so shadows
# don't look like black holes on a white background.

# ================= Surfaces =================
# Interactive chrome layers: borders, buttons, inputs, scrollbar.

surface = #313244
# Borders, button bg, input bg, code span bg, admonition table bg,
# heading underlines (h1, h2 in preview).

surface-hover = #45475a
# Hover/active states: button hover, CM6 selection bg, scrollbar
# thumb (including thumb:hover, the separate surface2 shade was
# trimmed because the thumb's geometric thickening on hover is the
# visible feedback, not the color change).

# ================= Text =================
# Four brightness levels from primary to barely-visible.

text = #cdd6f4
# Primary text: body, strong/em, dialog body, button text, CM6 fg.

text-muted = #bac2de
# Secondary: titlebar text, preview quote text, table caption,
# dialog title/message, statusbar filename, active gutter line number.

text-dim = #a6adc8
# Tertiary: statusbar base color, filetype label, cursor position
# readout, muted mode pill (Normal) foreground.

text-faint = #6c7086
# Dimmest: inactive gutter line numbers, CM6 comments, CM6 syntax
# punctuation, sync indicator at-rest color.

# ================= Accents =================
# Semantic accent colors. Each serves a specific UI/content purpose.

accent = #b4befe
# Primary accent: h1/h2 headings (preview + editor syntax), help
# dialog title, help button hover/focus color, focus-visible outlines
# on editor pane, confirm button, and help dialog.

accent-alt = #cba6f7
# Secondary accent: h3/h4 headings, quoteblock border-left accent,
# help dialog h3.

accent-minor = #f5c2e7
# Tertiary accent: h5/h6 headings, muted mode pill Visual bg.

link = #89b4fa
# Links (preview + editor syntax), info admonition border, example
# block border, Normal mode pill bg, titlebar help button default.

emphasis = #fab387
# Inline code color (preview + editor monospace/list syntax), dirty
# indicator dot, Command mode pill bg, warning admonition border,
# soft-column-limit over-limit indicator color + border.

warning = #f9e2af
# Caution admonition border, admonition default border, CM6
# attributeName syntax tag.

error = #f38ba8
# Render-error text + border, important admonition border, Replace
# mode pill bg, confirm discard button bg + border.

error-hover = #eba0ac
# Confirm discard button hover state (bg + border). Kept as an
# explicit slot rather than derived from error via opacity so
# theme authors have full control over the hover appearance.

success = #a6e3a1
# Tip admonition border, Insert mode pill bg.

feedback = #94e2d5
# Sync indicator flash color. The status bar arrow glyph spikes to
# this color when scroll-sync fires, then decays back to text-faint.

cursor = #f5e0dc
# CM6 caret color, .cm-cursor border, vim block cursor (.cm-fat-cursor)
# bg, unfocused fat-cursor outline.
