# Gruvbox Dark — Skrivro theme port
#
# Source: morhetz/gruvbox (https://github.com/morhetz/gruvbox)
# Palette reference: colors/gruvbox.vim, dark mode, medium contrast
#
# Gruvbox has a rich foreground gradient (fg1–fg4 + gray) so all four
# text levels use official palette values — no interpolation needed.
#
# Each key maps to a --skr-* CSS custom property. See the Catppuccin
# Mocha reference file (catppuccin-mocha.theme.default) for the full
# slot schema with purpose descriptions.

# Backgrounds
bg = #3c3836
bg-panel = #282828
bg-inset = #1d2021
bg-backdrop = rgba(29, 32, 33, 0.6)
bg-stripe = rgba(60, 56, 54, 0.3)
bg-active-line = rgba(80, 73, 69, 0.25)
shadow = rgba(0, 0, 0, 0.5)

# Surfaces
surface = #504945
surface-hover = #665c54

# Text — all official Gruvbox palette values
text = #ebdbb2
text-muted = #d5c4a1
text-dim = #bdae93
text-faint = #928374

# Accents
accent = #fabd2f
accent-alt = #d3869b
accent-minor = #83a598
link = #83a598
emphasis = #fe8019
warning = #fabd2f
error = #fb4934
error-hover = #cc241d
success = #b8bb26
feedback = #8ec07c
cursor = #ebdbb2
