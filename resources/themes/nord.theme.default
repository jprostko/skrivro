# Nord: Skrivro theme port
#
# Source: nordtheme.com / arcticicestudio/nord
# Palette: 16 colors across 4 categories (Polar Night, Snow Storm,
# Frost, Aurora). All accent values below are official Nord palette
# colors.
#
# Each key maps to a --skr-* CSS custom property. See the Catppuccin
# Mocha reference file (catppuccin-mocha.theme.default) for the full
# slot schema with purpose descriptions.

# Backgrounds
#
# Nord's official design language uses lighter shades for elevated
# surfaces (nord1 lighter than nord0). In Skrivro, that convention
# is inverted so the preview pane (bg-panel) is darker than the
# editor (bg), matching the visual convention of the other bundled
# themes where the preview is the darker pane. nord1 → bg (editor),
# nord0 → bg-panel (preview, status bar, dialogs).
bg = #3B4252
bg-panel = #2E3440
bg-inset = #272C36
bg-backdrop = rgba(46, 52, 64, 0.6)
bg-stripe = rgba(67, 76, 94, 0.3)
bg-active-line = rgba(67, 76, 94, 0.25)
shadow = rgba(0, 0, 0, 0.5)

# bg-inset (#272C36) is a computed shade slightly darker than nord0.
# The official Nord palette has no color darker than nord0: it is
# designed as the absolute floor. Without a darker shade, code blocks
# and literalblocks would have the same background as the body,
# making them visually indistinct. The computed value preserves the
# Nord tonal character while providing the necessary contrast.

# Surfaces
surface = #434C5E
surface-hover = #4C566A

# Text
#
# Nord has three Snow Storm shades (nord4/5/6) for light text and
# one Polar Night shade (nord3) for dim text like comments and line
# numbers. The gap between nord4 and nord3 is large with no official
# intermediate values. text-muted (#B5BCC9) and text-dim (#929AA9)
# below are computed intermediates to fill that gap for secondary
# and tertiary text (statusbar filename and labels, captions). They
# are NOT official Nord palette colors.
text = #D8DEE9
text-muted = #B5BCC9
text-dim = #929AA9
text-faint = #4C566A

# Accents: Frost (cool blues/cyans) and Aurora (warm colors)
accent = #88C0D0
accent-alt = #81A1C1
accent-minor = #B48EAD
link = #88C0D0
emphasis = #D08770
warning = #EBCB8B
error = #BF616A
error-hover = #CF6B73
success = #A3BE8C
feedback = #8FBCBB
cursor = #D8DEE9

# error-hover (#CF6B73) is a lightened variant of nord11 (#BF616A).
# Nord has no official "hover" or "bright" variant of its red. The
# value is computed to be visibly lighter on dark backgrounds while
# staying within Nord's cool-warm tonal range.
