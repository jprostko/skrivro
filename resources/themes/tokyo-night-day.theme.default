# Tokyo Night Day: Skrivro theme port
#
# Source: folke/tokyonight.nvim (https://github.com/folke/tokyonight.nvim)
# Palette reference: extras/lua/tokyonight_day.lua (authoritative
# pre-computed dump of the Day variant).
#
# Day is the official light variant of the Tokyo Night family. Pairs
# naturally with Skrivro's bundled Tokyo Night Moon, the same style
# language, flipped luminance.
#
# Skrivro convention: the editor pane on the left is the BRIGHTER
# surface, the preview pane on the right is slightly darker. Day's
# `bg` (#e1e2e7, lightest) goes to the editor and `bg_dark` (#d0d5e3)
# to the preview/status bar/dialogs.
#
# Shadow opacity is softened from Moon's 0.5 to 0.1 because dark
# translucent shadows read as harsh smudges against a near-white
# background.
#
# Each key maps to a --skr-* CSS custom property. See the Catppuccin
# Mocha reference file (catppuccin-mocha.theme.default) for the full
# slot schema with purpose descriptions.

# Backgrounds: editor brighter than preview per Skrivro convention
bg = #e1e2e7
bg-panel = #d0d5e3
bg-inset = #c1c9df
bg-backdrop = rgba(193, 201, 223, 0.6)
bg-stripe = rgba(196, 200, 218, 0.3)
bg-active-line = rgba(196, 200, 218, 0.25)
shadow = rgba(0, 0, 0, 0.1)

# Surfaces
surface = #c4c8da
surface-hover = #8990b3

# Text: dark-to-light gradient on light bg (most prominent first)
text = #3760bf
text-muted = #6172b0
text-dim = #848cb5
text-faint = #a1a6c5

# Accents: official Tokyo Night Day palette values
accent = #9854f1
accent-alt = #7847bd
accent-minor = #007197
link = #2e7de9
emphasis = #b15c00
warning = #8c6c3e
error = #f52a65
error-hover = #c64343
success = #587539
feedback = #118c74
cursor = #3760bf
