# Tokyo Night Moon: Skrivro theme port
#
# Source: folke/tokyonight.nvim (https://github.com/folke/tokyonight.nvim)
# Palette reference: lua/tokyonight/colors/moon.lua
# Moon is the default dark variant per the repo README (style = "moon").
#
# Each key maps to a --skr-* CSS custom property. See the Catppuccin
# Mocha reference file (catppuccin-mocha.theme.default) for the full
# slot schema with purpose descriptions.

# Backgrounds
bg = #222436
bg-panel = #1e2030
bg-inset = #191B29
bg-backdrop = rgba(25, 27, 41, 0.6)
bg-stripe = rgba(47, 51, 77, 0.3)
bg-active-line = rgba(47, 51, 77, 0.25)
shadow = rgba(0, 0, 0, 0.5)

# Surfaces
surface = #2f334d
surface-hover = #444a73

# Text
text = #c8d3f5
text-muted = #a9b1d6
text-dim = #828bb8
text-faint = #636da6

# Accents
accent = #c099ff
accent-alt = #fca7ea
accent-minor = #86e1fc
link = #82aaff
emphasis = #ff966c
warning = #ffc777
error = #ff757f
error-hover = #c53b53
success = #c3e88d
feedback = #4fd6be
cursor = #c8d3f5
