[Desktop Entry]
Type=Application
Version=1.0
Name=Skrivro
GenericName=AsciiDoc and Markdown Editor
Comment=Distraction-free editor with live preview for AsciiDoc and Markdown
Exec=skrivro %F
Icon=com.skrivro.editor
Terminal=false
Categories=Office;Publishing;Development;TextEditor;
MimeType=text/x-asciidoc;text/markdown;
Keywords=asciidoc;markdown;adoc;md;writing;markup;editor;
StartupWMClass=com.skrivro.editor
