<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared MIME info for AsciiDoc and Markdown source documents.

  Adds entries for text/x-asciidoc (AsciiDoc) and text/markdown
  (Markdown) to the shared-mime-info database, so xdg-mime queries
  return the specific type for .adoc/.asciidoc/.md/.markdown files
  rather than falling back to text/plain.

  Status of these types in upstream shared-mime-info:
    text/x-asciidoc: added in release 2.1 (2021)
    text/markdown:   added in release 1.6 (2015)

  Both types are in upstream on any modern distro, so this file is
  primarily useful for older systems or minimal installs that haven't
  picked up those upstream releases.

  IANA status:
    text/markdown:  standard registration, RFC 7763 (2016)
    text/asciidoc:  provisional registration via Eclipse Foundation
                    (2025-07-10). Upstream shared-mime-info still
                    uses x-asciidoc and we follow that until upstream
                    migrates.

  sub-class-of text/plain for both types lets generic text-handling
  tools open these files via inheritance, while tools claiming the
  specific type get priority.

  Glob patterns match exactly what Skrivro's resolveFormatForPath in
  tauri/src/io.ts classifies: .adoc and .asciidoc for AsciiDoc;
  .md and .markdown for Markdown. Other variants (.asc, .mdown,
  .mkd, .mkdn) exist but Skrivro doesn't classify them, so this XML
  doesn't claim them either. Keep this in sync with io.ts if either
  changes.

  Markdown has no <magic> block: the obvious markers (leading # for
  an h1, three dashes for YAML frontmatter) appear in too many plain
  text and YAML files to use as positive signals. Extension-only
  detection matches upstream shared-mime-info's approach. AsciiDoc's
  magic block stays because :author: / :doctype: are specific enough
  to AsciiDoc to be safe.

  Install instructions (user-level, for the current user):

    mkdir -p ~/.local/share/mime/packages/
    cp tauri/com.skrivro.editor.xml ~/.local/share/mime/packages/
    update-mime-database ~/.local/share/mime/

  System-wide install (requires root):

    sudo cp tauri/com.skrivro.editor.xml /usr/share/mime/packages/
    sudo update-mime-database /usr/share/mime/

  After either, `xdg-mime query filetype somefile.adoc` should report
  text/x-asciidoc, and `xdg-mime query filetype somefile.md` should
  report text/markdown. Log out and back in (or restart the file
  manager) for the change to appear in "Open with..." menus.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-asciidoc">
    <comment>AsciiDoc source document</comment>
    <comment xml:lang="en">AsciiDoc source document</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.adoc"/>
    <glob pattern="*.asciidoc"/>
    <magic priority="50">
      <match type="string" offset="0" value="= "/>
      <match type="string" offset="0" value=":author:"/>
      <match type="string" offset="0" value=":doctype:"/>
    </magic>
  </mime-type>
  <mime-type type="text/markdown">
    <comment>Markdown source document</comment>
    <comment xml:lang="en">Markdown source document</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.md"/>
    <glob pattern="*.markdown"/>
  </mime-type>
</mime-info>
