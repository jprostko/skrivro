# Skrivro config file — every key with its compiled-in default value,
# all commented out. This file ships with the source tree as a
# reference; to customize Skrivro, copy it to:
#
#   $XDG_CONFIG_HOME/skrivro/skrivro.conf
#   (or ~/.config/skrivro/skrivro.conf if $XDG_CONFIG_HOME is unset)
#
# then uncomment any line and edit. Every value shown below is the
# actual compiled-in default — uncommenting a line without changing
# it is a no-op.
#
# Skrivro's parser ignores missing keys, malformed lines, and unknown
# keys (with debug-mode warnings only), so you can leave whatever you
# don't care about commented out. Edits apply on next restart; there
# is no hot reload.

# ================= Fonts =================
# Font family keys are PREPENDED to the built-in CSS font stack, so
# if the font you pick isn't installed on the system the renderer
# falls through to the original stack — your setting is a preference,
# not a hard requirement.
#
# Font size keys: a bare positive number (integer or decimal) is
# assumed to be pt, so `14` and `14pt` produce the same result. An
# explicit unit (px, rem, em, %, ...) passes through to CSS
# unchanged. Zero or negative values are rejected.

# Editor (monospace) font. Built-in fallback stack:
#   ui-monospace, JetBrains Mono, Cascadia Code, Fira Code,
#   Menlo, Monaco, Consolas, monospace
# edit-font = ui-monospace

# Preview (sans-serif) font. Built-in fallback stack:
#   -apple-system, BlinkMacSystemFont, Inter, Segoe UI, Roboto,
#   Helvetica Neue, Arial, sans-serif
# preview-font = system-ui

# edit-font-size = 0.9rem
# preview-font-size = 0.95rem

# ================= Layout =================
# Padding keys are split by axis: `-x` for horizontal (left/right),
# `-y` for vertical (top/bottom). Each key accepts one or two values.
# One value applies uniformly to both ends of the axis. Two values
# are in reading order: for `-y` that's `top bottom`, for `-x` that's
# `left right`. Bare numbers in any position default to pt; explicit
# units pass through. Three or more values are rejected.
#
# Example (asymmetric top vs. bottom):
#   editor-padding-y = 2rem 3rem     # top = 2rem, bottom = 3rem
#
# Example (uniform horizontal):
#   editor-padding-x = 20px          # both left and right = 20px
#
# Pane width keys apply only in single-pane modes (editor-only and
# preview-only) and cap the reading column at that width, centering
# it in the window. They do NOT apply in split mode — each pane
# already shares the window 50/50 via flexbox. Width values REQUIRE
# an explicit unit (bare numbers are rejected); accepted units
# include px, %, vw, rem, em, and ch. The `ch` unit is useful for
# prose: `edit-pane-width = 80ch` gives roughly 80 characters wide
# — exact in the monospace editor, approximate in the proportional
# preview.

# editor-padding-x = 2.5rem
# editor-padding-y = 2rem
# preview-padding-x = 2.5rem
# preview-padding-y = 2rem

# edit-pane-width = 900px
# preview-pane-width = 900px

# ================= Theme =================
# Only `catppuccin-mocha` is supported in v1. This key exists as an
# extension point — a future version may support user-supplied themes
# under $XDG_CONFIG_HOME/skrivro/themes/<name>.conf.
# theme = catppuccin-mocha

# ================= Asciidoctor =================
# Asciidoctor safe mode — unsafe / safe / server / secure.
#
# Controls which Asciidoctor features are enabled. `unsafe` is the
# most permissive: includes across directories, docinfo files, book
# doctype, and arbitrary attribute setting all work. `secure` disables
# nearly all of it. This is a set-and-forget knob, deliberately not
# exposed in the UI — once you've chosen a safe mode, runtime display
# has no value.
# asciidoc-safe-mode = unsafe

# ================= Status bar =================

# Cursor position format — verbose / compact / ruler
#   verbose: Ln 42, Col 85    (prose-editor default)
#   compact: 42:85            (code-editor style)
#   ruler:   42,85            (Vim ruler style)
# cursor-position-format = verbose

# Status bar mode pill style — canonical / muted
#   canonical: bright Catppuccin palette from catppuccin/nvim's
#              lualine.lua — blue / green / mauve / red / peach
#   muted:     Normal = surface0 + subtext0, Visual = pink + base;
#              Insert / Replace / Command stay canonical.
#              LazyVim-inspired.
# statusbar-style = canonical

# Soft column limit — positive integer, no default. When set, the Col
# indicator in the status bar turns peach once the cursor's column
# on the current LOGICAL line exceeds this value. Useful for prose
# workflows with hard line-width conventions (80- or 100-char commit
# messages, reStructuredText, Markdown with strict line limits, etc.).
#
# Character-based: counts actual characters (codepoints), not bytes
# or visual cells. Em-dashes, emoji, and accented letters count as 1.
#
# Document-column, not visual-column: soft wrap is a display concern
# and does NOT reset the count. If you type 150 characters on one
# logical line in a window narrow enough to wrap at 60 characters,
# the indicator still flags at col > limit — because the count is
# based on the source document, not the rendered layout.
#
# No default: omit this key entirely if you write prose as "one
# paragraph per line" (where soft wrap handles the visual display
# and you don't care about source-line length). Set it explicitly
# if your workflow treats source lines as having a fixed width.
# soft-column-limit = 100
