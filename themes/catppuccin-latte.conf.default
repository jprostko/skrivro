# Catppuccin Latte — Skrivro theme port
#
# Source: catppuccin/palette (https://github.com/catppuccin/palette)
# Palette reference: palette.json, Latte variant
#
# Latte is the official light variant of Catppuccin. Pairs naturally
# with Skrivro's bundled Catppuccin Mocha (the CSS default) — same
# color family, flipped luminance.
#
# Skrivro convention: the editor pane on the left is the BRIGHTER
# surface, the preview pane on the right is slightly darker. For a
# light theme that means the editor gets `base` (#eff1f5, lightest)
# and the preview gets `mantle` (#e6e9ef, slightly off-white).
#
# Shadow opacity is softened from Mocha's 0.5 to 0.1 because dark
# translucent shadows read as harsh smudges against a near-white
# background.
#
# Each key maps to a --skr-* CSS custom property. See the Catppuccin
# Mocha reference file (catppuccin-mocha.conf.default) for the full
# slot schema with purpose descriptions.

# Backgrounds — editor brighter than preview per Skrivro convention
bg = #eff1f5
bg-panel = #e6e9ef
bg-inset = #dce0e8
bg-backdrop = rgba(220, 224, 232, 0.6)
bg-stripe = rgba(204, 208, 218, 0.3)
bg-active-line = rgba(204, 208, 218, 0.25)
shadow = rgba(0, 0, 0, 0.1)

# Surfaces
surface = #ccd0da
surface-hover = #bcc0cc

# Text — dark-to-light gradient on light bg (most prominent first)
text = #4c4f69
text-muted = #5c5f77
text-dim = #6c6f85
text-faint = #9ca0b0

# Accents — official Catppuccin Latte palette values
accent = #7287fd
accent-alt = #8839ef
accent-minor = #ea76cb
link = #1e66f5
emphasis = #fe640b
warning = #df8e1d
error = #d20f39
error-hover = #e64553
success = #40a02b
feedback = #179299
cursor = #dc8a78
