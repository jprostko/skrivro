# Dracula — Skrivro theme port
#
# Source: dracula/vim (https://github.com/dracula/vim)
# Palette reference: autoload/dracula.vim
#
# Each key maps to a --skr-* CSS custom property. See the Catppuccin
# Mocha reference file (catppuccin-mocha.conf) for the full slot schema
# with purpose descriptions.

# Backgrounds
bg = #282A36
bg-panel = #21222C
bg-inset = #191A21
bg-backdrop = rgba(25, 26, 33, 0.6)
bg-stripe = rgba(68, 71, 90, 0.3)
bg-active-line = rgba(68, 71, 90, 0.25)
shadow = rgba(0, 0, 0, 0.5)

# Surfaces
surface = #44475A
surface-hover = #424450

# Text
#
# Dracula's official palette has only two text levels: fg (#F8F8F2) and
# comment (#6272A4). That's a large brightness gap with no intermediate
# shades for secondary/tertiary text (titlebar, captions, statusbar
# labels). text-muted and text-dim below are computed midpoints between
# fg and comment to fill that gap. They are NOT official Dracula palette
# colors — they are interpolations chosen to produce natural-looking
# intermediate grays that feel consistent with Dracula's cool-toned
# aesthetic.
text = #F8F8F2
text-muted = #ADB5CB
text-dim = #8893B7
text-faint = #6272A4

# Accents
accent = #BD93F9
accent-alt = #FF79C6
accent-minor = #8BE9FD
link = #8BE9FD
emphasis = #FFB86C
warning = #F1FA8C
error = #FF5555
error-hover = #FF6E6E
success = #50FA7B
feedback = #8BE9FD
cursor = #F8F8F2
